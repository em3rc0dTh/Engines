{
  "datasetVersion": "mk0.golden.register-customer.v0",
  "workflowType": "RegisterNewCustomer",
  "syntheticDataOnly": true,
  "architectureProfile": {
    "cta": "omnichannel-via-cta-adapter",
    "initialCtaSenders": ["postman", "cli"],
    "futureCtaSenders": ["form", "mcp", "whatsapp", "telegram", "api-webhook"],
    "frameworkRequired": false,
    "orchestration": "temporal-full-platform",
    "temporalRuntimeRequired": true,
    "temporalRuntimePath": ["client", "service", "task-queue", "worker", "workflow", "query", "update", "activities"],
    "businessPersistence": "postgresql",
    "interactionAuditPersistence": "mongodb",
    "attachmentPersistence": "attachment-store-technology-to-be-frozen-at-build-gate"
  },
  "registrationPolicies": [
    {
      "policyId": "golden-registration-v1",
      "policyVersion": "1",
      "businessSlug": "golden-business",
      "required": [
        "customer.name",
        "customer.contact.phoneOrEmail"
      ],
      "duplicatePolicy": {
        "hardUnique": ["customer.document.type+customer.document.country+customer.document.value"],
        "softMatch": ["customer.contact.phones[].normalized", "customer.contact.email"],
        "nonUnique": ["customer.name"]
      },
      "documentRequired": false,
      "attachmentsRequired": false
    }
  ],
  "cases": [
    {
      "id": "GD-001",
      "name": "minimal-valid-customer-complete-at-start",
      "start": {
        "operation": "RegisterNewCustomer",
        "businessSlug": "golden-business",
        "draft": {
          "customer": {
            "type": "person",
            "name": "Ana Torres",
            "contact": {"phones": [], "email": "ana.torres@example.test"}
          }
        },
        "request": {"idempotencyKey": "gd-001-session", "channel": "postman"}
      },
      "expected": {
        "workflowStarted": true,
        "policyId": "golden-registration-v1",
        "workflowTerminalStatus": "COMPLETED",
        "terminalPhase": "CREATED",
        "created": true,
        "postgresCustomerDelta": 1,
        "mongoInteractionAuditPresent": true,
        "appointmentDelta": 0,
        "resourceReservationDelta": 0,
        "availabilitySlotMutationDelta": 0
      }
    },
    {
      "id": "GD-002",
      "name": "full-valid-customer",
      "start": {
        "operation": "RegisterNewCustomer",
        "businessSlug": "golden-business",
        "draft": {
          "customer": {
            "type": "person",
            "name": "Luis Vega",
            "document": {"type": "DNI", "value": "00000002", "country": "PE"},
            "contact": {
              "phones": [
                {
                  "label": "principal",
                  "countryCode": "+51",
                  "number": "900000002",
                  "normalized": "51900000002",
                  "isWhatsapp": true,
                  "primary": true
                }
              ],
              "email": "luis.vega@example.test"
            },
            "notes": "Synthetic golden customer"
          }
        },
        "request": {"idempotencyKey": "gd-002-session", "channel": "cli"}
      },
      "expected": {
        "workflowTerminalStatus": "COMPLETED",
        "terminalPhase": "CREATED",
        "created": true,
        "postgresCustomerDelta": 1,
        "mongoInteractionAuditPresent": true
      }
    },
    {
      "id": "GD-003",
      "name": "one-attachment",
      "preconditions": {
        "stagedAttachments": [
          {
            "fixture": "synthetic-id-front-v1",
            "ingressRef": "ing_gd003_a",
            "mediaType": "image/png",
            "sha256": "TO_BE_FROZEN_WITH_BINARY_FIXTURE"
          }
        ]
      },
      "start": {
        "operation": "RegisterNewCustomer",
        "businessSlug": "golden-business",
        "draft": {
          "customer": {
            "type": "person",
            "name": "Mara Rios",
            "contact": {"phones": [], "email": "mara.rios@example.test"}
          },
          "attachments": [
            {"ingressRef": "ing_gd003_a", "kind": "identity_document", "displayName": "Synthetic ID front"}
          ]
        },
        "request": {"idempotencyKey": "gd-003-session"}
      },
      "expected": {
        "workflowTerminalStatus": "COMPLETED",
        "terminalPhase": "CREATED",
        "postgresCustomerDelta": 1,
        "committedAttachmentDelta": 1,
        "postgresCustomerAttachmentReferenceCount": 1,
        "binaryEmbeddedInPostgresCustomer": false
      }
    },
    {
      "id": "GD-004",
      "name": "multiple-attachments",
      "preconditions": {
        "stagedAttachments": [
          {"fixture": "synthetic-a", "ingressRef": "ing_gd004_a", "sha256": "TO_BE_FROZEN"},
          {"fixture": "synthetic-b", "ingressRef": "ing_gd004_b", "sha256": "TO_BE_FROZEN"}
        ]
      },
      "start": {
        "operation": "RegisterNewCustomer",
        "businessSlug": "golden-business",
        "draft": {
          "customer": {
            "type": "person",
            "name": "Noa Diaz",
            "contact": {"phones": [], "email": "noa.diaz@example.test"}
          },
          "attachments": [
            {"ingressRef": "ing_gd004_a", "kind": "identity_document", "displayName": "Synthetic A"},
            {"ingressRef": "ing_gd004_b", "kind": "supporting_document", "displayName": "Synthetic B"}
          ]
        },
        "request": {"idempotencyKey": "gd-004-session"}
      },
      "expected": {
        "workflowTerminalStatus": "COMPLETED",
        "postgresCustomerDelta": 1,
        "committedAttachmentDelta": 2,
        "postgresCustomerAttachmentReferenceCount": 2,
        "finalizeOnlyAfterAllAttachments": true
      }
    },
    {
      "id": "GD-005",
      "name": "exact-start-session-replay",
      "replayCase": "GD-001",
      "repetitions": 2,
      "expected": {
        "sameWorkflowIdentity": true,
        "postgresCustomerDeltaAcrossAllRepetitions": 1,
        "logicalRegistrationOutcomeCount": 1
      }
    },
    {
      "id": "GD-006",
      "name": "session-idempotency-immutable-start-conflict",
      "firstStart": {
        "operation": "RegisterNewCustomer",
        "businessSlug": "golden-business",
        "request": {"idempotencyKey": "gd-006-session"}
      },
      "secondStart": {
        "operation": "RegisterNewCustomer",
        "businessSlug": "different-business",
        "request": {"idempotencyKey": "gd-006-session"}
      },
      "expected": {
        "secondStartAccepted": false,
        "secondErrorCode": "SESSION_IDEMPOTENCY_CONFLICT",
        "additionalPostgresCustomerDelta": 0
      }
    },
    {
      "id": "GD-007",
      "name": "invalid-start-missing-business-slug",
      "start": {
        "operation": "RegisterNewCustomer",
        "draft": {"customer": {}},
        "request": {"idempotencyKey": "gd-007-session"}
      },
      "expected": {
        "startAccepted": false,
        "workflowStarted": false,
        "postgresCustomerDelta": 0
      }
    },
    {
      "id": "GD-008",
      "name": "transient-postgresql-customer-write-failure",
      "baseCase": "GD-001",
      "failureInjection": {
        "target": "createCustomer",
        "classification": "POSTGRES_CUSTOMER_STORE_UNAVAILABLE",
        "attemptsToFail": 1
      },
      "expected": {
        "workflowTerminalStatus": "COMPLETED",
        "postgresCustomerDelta": 1,
        "activityRetryObserved": true
      }
    },
    {
      "id": "GD-009",
      "name": "transient-attachment-store-failure",
      "baseCase": "GD-003",
      "failureInjection": {
        "target": "commitAttachment",
        "classification": "ATTACHMENT_STORE_UNAVAILABLE",
        "attemptsToFail": 1
      },
      "expected": {
        "workflowTerminalStatus": "COMPLETED",
        "postgresCustomerDelta": 1,
        "committedAttachmentDelta": 1,
        "customerFinalizedBeforeRecovery": false
      }
    },
    {
      "id": "GD-010",
      "name": "permanent-attachment-hash-mismatch",
      "baseCase": "GD-003",
      "failureInjection": {
        "target": "commitAttachment",
        "classification": "ATTACHMENT_INTEGRITY_MISMATCH",
        "permanent": true
      },
      "expected": {
        "workflowTerminalStatus": "FAILED",
        "failureCode": "ATTACHMENT_INTEGRITY_MISMATCH",
        "customerReportedAsSuccessful": false
      }
    },
    {
      "id": "GD-011",
      "name": "worker-restart-while-running",
      "baseCase": "GD-001",
      "failureInjection": {"target": "temporal-worker", "action": "restart"},
      "expected": {
        "workflowTerminalStatus": "COMPLETED",
        "acceptedSessionLost": false,
        "postgresCustomerDelta": 1
      }
    },
    {
      "id": "GD-012",
      "name": "scheduling-isolation",
      "baseCase": "GD-002",
      "expected": {
        "appointmentDelta": 0,
        "resourceReservationDelta": 0,
        "availabilitySlotMutationDelta": 0
      }
    },
    {
      "id": "GD-013",
      "name": "cta-disconnect-reconnect-continuity",
      "baseCase": "GD-015",
      "scenario": {
        "after": "WAITING_FOR_REQUIRED_DATA",
        "ctaAction": "disconnect-or-stop",
        "laterCtaAction": "reconnect-query-and-update-same-workflow-id"
      },
      "expected": {
        "sameWorkflowIdentityObservedAfterReconnect": true,
        "sameDurableDraftObservedAfterReconnect": true,
        "acceptedSessionLost": false
      }
    },
    {
      "id": "GD-014",
      "name": "full-temporal-runtime-proof",
      "baseCase": "GD-016",
      "requiredRuntimePath": [
        "temporal-client",
        "temporal-service",
        "task-queue",
        "worker",
        "RegisterNewCustomer-workflow",
        "GetRegistrationState-query",
        "ProvideCustomerData-update",
        "persistence-activity"
      ],
      "expected": {
        "realTemporalServiceObserved": true,
        "workflowIdObserved": true,
        "runIdObserved": true,
        "taskQueueExecutionObserved": true,
        "workerExecutionObserved": true,
        "queryObserved": true,
        "updateObserved": true,
        "activityExecutionObserved": true,
        "eventHistoryObserved": true,
        "inProcessFakeOrchestrator": false
      }
    },
    {
      "id": "GD-015",
      "name": "intent-only-start-waits-for-required-data",
      "start": {
        "operation": "RegisterNewCustomer",
        "businessSlug": "golden-business",
        "draft": {"customer": {}},
        "request": {"idempotencyKey": "gd-015-session", "channel": "postman"}
      },
      "expected": {
        "workflowStarted": true,
        "phase": "WAITING_FOR_REQUIRED_DATA",
        "policyId": "golden-registration-v1",
        "missingFields": ["customer.name", "customer.contact.phoneOrEmail"],
        "nextAction": "PROVIDE_CUSTOMER_DATA",
        "postgresCustomerDelta": 0
      }
    },
    {
      "id": "GD-016",
      "name": "multi-round-customer-data-updates",
      "baseCase": "GD-015",
      "updates": [
        {
          "updateName": "ProvideCustomerData",
          "inputId": "gd-016-input-1",
          "customerPatch": {"name": "Iris Sol"},
          "expectedPhase": "WAITING_FOR_REQUIRED_DATA",
          "expectedMissingFields": ["customer.contact.phoneOrEmail"]
        },
        {
          "updateName": "ProvideCustomerData",
          "inputId": "gd-016-input-2",
          "customerPatch": {"contact": {"phones": [], "email": "iris.sol@example.test"}},
          "expectedEventually": "CREATED"
        }
      ],
      "expected": {
        "sameWorkflowIdentityThroughout": true,
        "workflowTerminalStatus": "COMPLETED",
        "terminalPhase": "CREATED",
        "postgresCustomerDelta": 1,
        "mongoAcceptedInteractionCountMinimum": 2
      }
    },
    {
      "id": "GD-017",
      "name": "hard-duplicate-resolves-existing-customer",
      "preconditions": {
        "existingCustomer": {
          "businessSlug": "golden-business",
          "name": "Existing DNI Customer",
          "document": {"type": "DNI", "country": "PE", "value": "77777777"},
          "contact": {"phones": [], "email": "existing@example.test"}
        }
      },
      "start": {
        "operation": "RegisterNewCustomer",
        "businessSlug": "golden-business",
        "draft": {
          "customer": {
            "name": "Another Display Name",
            "document": {"type": "DNI", "country": "PE", "value": "77777777"},
            "contact": {"phones": [], "email": "new-email@example.test"}
          }
        },
        "request": {"idempotencyKey": "gd-017-session"}
      },
      "expected": {
        "workflowTerminalStatus": "COMPLETED",
        "terminalPhase": "ALREADY_EXISTS",
        "created": false,
        "existingCustomerIdReturned": true,
        "additionalPostgresCustomerDelta": 0,
        "duplicateClassification": "HARD_UNIQUE"
      }
    },
    {
      "id": "GD-018",
      "name": "soft-duplicate-does-not-become-hard-rule",
      "preconditions": {
        "existingCustomer": {
          "businessSlug": "golden-business",
          "name": "Shared Phone Existing",
          "contact": {
            "phones": [{"normalized": "51911111111"}],
            "email": "shared@example.test"
          }
        }
      },
      "start": {
        "operation": "RegisterNewCustomer",
        "businessSlug": "golden-business",
        "draft": {
          "customer": {
            "name": "Different Person",
            "contact": {
              "phones": [{"normalized": "51911111111"}],
              "email": "different@example.test"
            }
          }
        },
        "request": {"idempotencyKey": "gd-018-session"}
      },
      "expected": {
        "duplicateClassification": "SOFT_MATCH",
        "hardDuplicateRejected": false,
        "policyDefinedResolutionRequired": true
      }
    }
  ]
}
