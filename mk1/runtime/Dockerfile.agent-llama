FROM debian:bookworm-slim AS builder

ARG LLAMA_CPP_COMMIT=b29c606e28a01b1bc8c1351026a0fa6e616bf6c4

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      cmake \
      g++ \
      git \
      libcurl4-openssl-dev \
      ninja-build \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none --no-checkout https://github.com/ggml-org/llama.cpp.git /src/llama.cpp \
    && git -C /src/llama.cpp fetch --depth 1 origin "${LLAMA_CPP_COMMIT}" \
    && git -C /src/llama.cpp checkout --detach "${LLAMA_CPP_COMMIT}"

RUN cmake \
      -S /src/llama.cpp \
      -B /src/llama.cpp/build \
      -G Ninja \
      -DGGML_NATIVE=OFF \
      -DGGML_OPENMP=ON \
      -DGGML_CUDA=OFF \
      -DLLAMA_CURL=ON \
      -DBUILD_SHARED_LIBS=OFF \
    && cmake --build /src/llama.cpp/build --target llama-server -j 2

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      libcurl4 \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server
COPY scripts/run-agent-llama.sh /usr/local/bin/run-agent-llama.sh

RUN chmod 0755 /usr/local/bin/llama-server /usr/local/bin/run-agent-llama.sh \
    && mkdir -p /models

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/run-agent-llama.sh"]
